{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melora",
  "version": "../package.json",
  "identifier": "app.melora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Melora",
        "width": 1440,
        "height": 940,
        "visible": false,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "backgroundColor": "#080e0b",
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "resources": [],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
