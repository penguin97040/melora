{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window with only required window controls and event subscriptions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-window-chrome",
    "allow-app-info",
    "allow-save-preferences",
    "allow-show-main-window",
    "ora:allow-status",
    "ora:allow-sign-in",
    "ora:allow-cancel-sign-in",
    "ora:allow-sign-out",
    "ora:allow-set-client-id",
    "ora:allow-profile",
    "ora:allow-subscribe",
    "ora:allow-open-in-spotify",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
