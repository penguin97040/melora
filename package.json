{
  "name": "melora",
  "version": "0.7.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src ora/sdk-bridge scripts/*.mjs *.json *.ts *.js index.html README.md DEVELOPMENT.md src-tauri/tauri*.conf.json",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src ora/sdk-bridge scripts/*.mjs *.json *.ts *.js index.html README.md DEVELOPMENT.md src-tauri/tauri*.conf.json",
    "test": "node node_modules/vitest/vitest.mjs run",
    "build": "npm run typecheck && node node_modules/vite/bin/vite.js build && node scripts/check-assets.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "tauri": "node node_modules/@tauri-apps/cli/tauri.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && python3 -m unittest discover -s scripts/tests && bash scripts/check-ora-boundaries.sh",
    "build:windows": "node scripts/build-windows.mjs",
    "build:linux": "node scripts/build-linux.mjs",
    "gate": "python3 scripts/publication_gate.py"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@fontsource/ubuntu-mono": "5.3.0",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
